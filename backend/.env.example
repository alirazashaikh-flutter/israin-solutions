# Render dashboard > Environment par in keys ko apne asli .env se copy karo
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/israin_solutions
JWT_SECRET=<apna naya random secret>
NODE_ENV=production

# AI Keys
GEMINI_API_KEY=<value>
OPENAI_API_KEY=<value>
GROQ_API_KEY=<value>

# Email (Gmail SMTP)
SMTP_USER=<email>
SMTP_PASS=<app password>
SMTP_FROM=<email>

# PayPal
PAYPAL_CLIENT_ID=<value>
PAYPAL_SECRET=<value>
PAYPAL_MODE=sandbox
# Deploy karne ke baad ye badlao: https://<your-service>.onrender.com
PAYPAL_PUBLIC_URL=http://localhost:5000